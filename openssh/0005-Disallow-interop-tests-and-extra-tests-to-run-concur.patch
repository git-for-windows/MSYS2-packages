From af27fac83be64eb3dda89e40f10a198b1b7397f2 Mon Sep 17 00:00:00 2001
From: Johannes Schindelin <johannes.schindelin@gmx.de>
Date: Tue, 19 Dec 2023 00:46:56 +0100
Subject: [PATCH 5/5] Disallow interop-tests and extra-tests to run
 concurrently

These two test suites try to create/access the same files, that's why.

Signed-off-by: Johannes Schindelin <johannes.schindelin@gmx.de>
---
 Makefile.in | 2 ++
 1 file changed, 2 insertions(+)

diff --git a/Makefile.in b/Makefile.in
index a7241fc5..911e2b44 100644
--- a/Makefile.in
+++ b/Makefile.in
@@ -826,6 +826,8 @@ unit-bench: regress-unit-binaries
 
 TEST_SSH_SSHD="$(BUILDDIR)/sshd"
 
+extra-tests: | interop-tests
+
 interop-tests t-exec file-tests extra-tests: regress-prep regress-binaries $(TARGETS)
 	cd $(srcdir)/regress || exit $$?; \
 	AWK='@AWK@' \
